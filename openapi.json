  "info": {
    "title": "Serviço NFS-e Nacional",
    "description": "Emissão assíncrona, consulta e cancelamento por emitente. Informe X-Emitter-Cnpj em todas as operações autenticadas.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "CreateCertificateDto": {
        "type": "object",
        "properties": {
          "pfxBase64": {
            "type": "string",
            "description": "Arquivo PKCS#12 em base64; limite de 1 MB",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "pfxBase64",
          "password"
        ]
      },
      "CertificateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cnpj": {
            "type": "string"
          },
          "subjectName": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REPLACED",
              "REVOKED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "cnpj",
          "subjectName",
          "fingerprint",
          "validFrom",
          "validUntil",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateCertificateDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "REVOKED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateCityConfigDto": {
        "type": "object",
        "properties": {
          "cityCode": {
            "type": "number"
          },
          "environment": {
            "type": "string",
            "enum": [
              "HOMOLOGATION",
              "PRODUCTION"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "series": {
            "type": "string",
            "description": "Formato ilustrativo: 1"
          },
          "cancellationWindowDays": {
            "type": "number"
          },
          "webhookUrl": {
            "type": "string"
          },
          "webhookSecret": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "cityCode",
          "environment",
          "enabled",
          "series"
        ]
      },
      "CityConfigResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cnpj": {
            "type": "string"
          },
          "cityCode": {
            "type": "number"
          },
          "environment": {
            "type": "string",
            "enum": [
              "HOMOLOGATION",
              "PRODUCTION"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "series": {
            "type": "string"
          },
          "cancellationWindowDays": {
            "type": "number",
            "nullable": true
          },
          "webhookUrl": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "cnpj",
          "cityCode",
          "environment",
          "enabled",
          "series",
          "cancellationWindowDays",
          "webhookUrl",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateCityConfigDto": {
        "type": "object",
        "properties": {
          "cityCode": {
            "type": "number"
          },
          "environment": {
            "type": "string",
            "enum": [
              "HOMOLOGATION",
              "PRODUCTION"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "series": {
            "type": "string",
            "description": "Formato ilustrativo: 1"
          },
          "cancellationWindowDays": {
            "type": "number"
          },
          "webhookUrl": {
            "type": "string"
          },
          "webhookSecret": {
            "type": "string",
            "writeOnly": true
          }
        }
      },
      "IssuerDto": {
        "type": "object",
        "properties": {
          "cnpj": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cityCode": {
            "type": "number"
          },
          "municipalRegistration": {
            "type": "string"
          },
          "simplesNacional": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "simplesNacionalRegime": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "specialTaxRegime": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "2",
              "3",
              "4",
              "5",
              "6",
              "9"
            ]
          }
        },
        "required": [
          "cnpj",
          "name",
          "cityCode",
          "simplesNacional",
          "specialTaxRegime"
        ]
      },
      "TakerDto": {
        "type": "object",
        "properties": {
          "cnpj": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "cnpj",
          "name"
        ]
      },
      "ServiceDto": {
        "type": "object",
        "properties": {
          "lc116Code": {
            "type": "string",
            "description": "Formato ilustrativo: 01.01"
          },
          "nationalServiceCode": {
            "type": "string",
            "description": "Formato ilustrativo: 010101"
          },
          "municipalTaxCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "issqnTaxation": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4"
            ]
          },
          "issRate": {
            "type": "string",
            "description": "Formato ilustrativo: 2.00"
          },
          "issWithheld": {
            "type": "boolean"
          }
        },
        "required": [
          "lc116Code",
          "nationalServiceCode",
          "description",
          "issqnTaxation",
          "issRate",
          "issWithheld"
        ]
      },
      "ValuesDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Formato ilustrativo: 1500.00"
          },
          "totalFederalTaxPercent": {
            "type": "string",
            "description": "Formato ilustrativo: 0.00"
          },
          "totalStateTaxPercent": {
            "type": "string",
            "description": "Formato ilustrativo: 0.00"
          },
          "totalMunicipalTaxPercent": {
            "type": "string",
            "description": "Formato ilustrativo: 0.00"
          }
        },
        "required": [
          "amount",
          "totalFederalTaxPercent",
          "totalStateTaxPercent",
          "totalMunicipalTaxPercent"
        ]
      },
      "CreateInvoiceDto": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "HOMOLOGATION",
              "PRODUCTION"
            ]
          },
          "issuer": {
            "$ref": "#/components/schemas/IssuerDto"
          },
          "taker": {
            "$ref": "#/components/schemas/TakerDto"
          },
          "serviceCityCode": {
            "type": "number"
          },
          "competency": {
            "type": "string",
            "description": "Formato ilustrativo: 2026-10-01"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceDto"
          },
          "values": {
            "$ref": "#/components/schemas/ValuesDto"
          }
        },
        "required": [
          "externalId",
          "environment",
          "issuer",
          "taker",
          "serviceCityCode",
          "competency",
          "service",
          "values"
        ]
      },
      "FiscalEventResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
