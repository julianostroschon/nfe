# Gere valores locais com pnpm ambiente-teste. Não use dados de teste em produção.
PORT=3000
DATABASE_URL=mysql://fiscal:SUBSTITUA@127.0.0.1:3307/fiscal
REDIS_URL=redis://127.0.0.1:6380
# Namespace opcional da fila; padrão derivado do banco.
# QUEUE_PREFIX=nfse-fiscal
MYSQL_PASSWORD=SUBSTITUA
MYSQL_ROOT_PASSWORD=SUBSTITUA
MYSQL_PORT=3307
REDIS_PORT=6380
# 32 bytes em base64 ou hexadecimal. A perda da chave impede abrir os certificados.
CREDENTIALS_ENCRYPTION_KEY=SUBSTITUA
# SHA-256 das API keys e lista explícita de emitentes autorizados.
API_KEY_HASHES_JSON=[{"sha256":"SUBSTITUA","cnpjs":["12345678000195"]}]
# O pedido também declara o ambiente; nunca se deduz produção de variável ausente.
NFSE_ENVIRONMENT=HOMOLOGATION
# Somente para o simulador; produção recusa esta variável.
# NFSE_BASE_URL_OVERRIDE=127.0.0.1:8443
# Opcional: caminho absoluto dos XSDs; padrão schemas/v1.01 relativo ao diretório atual.
# NFSE_SCHEMA_DIR=/app/schemas/v1.01
